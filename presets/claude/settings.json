{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1",
    "DISABLE_EXTRA_USAGE_COMMAND": "1",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "CLAUDE_CODE_SIMPLE_SYSTEM_PROMPT": "1",
    "ENABLE_TOOL_SEARCH": "auto",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "0"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "includeGitInstructions": false,
  "permissions": {
    "allow": [
      "Bash(./gradlew test*)",
      "Bash(./gradlew build*)",
      "Bash(./gradlew check*)",
      "Bash(npm test*)",
      "Bash(npm run lint*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git stash*)",
      "Bash(git checkout*)",
      "Bash(git restore*)",
      "Bash(git pull*)",
      "Bash(git fetch*)",
      "Bash(git merge*)",
      "Bash(npm run *)",
      "Bash(npm ci)",
      "Bash(pnpm run *)",
      "Bash(pnpm test*)",
      "Bash(pnpm exec *)",
      "Bash(pnpm dlx *)",
      "Bash(yarn run *)",
      "Bash(yarn test*)",
      "Bash(npx *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pip list*)",
      "Bash(pip show *)",
      "Bash(pytest*)",
      "Bash(ruff*)",
      "Bash(black --check *)",
      "Bash(./gradlew *)",
      "Bash(gradle *)",
      "Bash(mvn test*)",
      "Bash(mvn compile*)",
      "Bash(java -version)",
      "Bash(kotlin -version)",
      "Bash(docker ps*)",
      "Bash(docker logs*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Read(**)",
      "Edit(**)",
      "WebFetch(*)"
    ],
    "deny": [
      "Agent(bypass-runner)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(chmod 777 *)",
      "Bash(chown *)",
      "Bash(dd *)",
      "Bash(mkfs *)",
      "Bash(diskutil *)",
      "Bash(mount *)",
      "Bash(umount *)",
      "Bash(systemctl *)",
      "Bash(launchctl *)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git rebase *)",
      "Bash(git reset --hard *)",
      "Bash(rm -fr *)",
      "Bash(chmod -R *)",
      "Bash(eval *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git rebase *)",
      "PowerShell(Invoke-Expression *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(!.env.example)",
      "Read(secrets/**)",
      "Edit(secrets/**)",
      "Read(**/credentials.json)",
      "Edit(**/credentials.json)",
      "Read(**/serviceAccount*.json)",
      "Edit(**/serviceAccount*.json)",
      "Read(**/*.pem)",
      "Edit(**/*.pem)",
      "Read(**/*.key)",
      "Edit(**/*.key)",
      "Read(**/id_rsa*)",
      "Edit(**/id_rsa*)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Edit(~/.gnupg/**)"
    ],
    "ask": [
      "Bash(docker run*)",
      "Bash(docker compose up*)",
      "Bash(docker compose down*)"
    ],
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/invoke-hook.cjs post-tool"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/invoke-hook.cjs pre-tool"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/invoke-hook.cjs session-start"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"var fs=require('fs');var os=require('os');var p=require('path');var dir=p.join(os.homedir(),'.claude');fs.mkdirSync(dir,{recursive:true});fs.appendFileSync(p.join(dir,'subagent.log'),'[subagent fin] '+new Date().toISOString()+'\\n');\""
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "agricidaniel-claude-seo": {
      "source": {
        "source": "github",
        "repo": "AgriciDaniel/claude-seo"
      }
    }
  },
  "language": "spanish",
  "model": "sonnet",
  "effortLevel": "medium",
  "feedbackSurveyRate": 0,
  "spinnerTipsEnabled": false,
  "awaySummaryEnabled": false,
  "showClearContextOnPlanAccept": true,
  "autoUpdatesChannel": "latest",
  "prefersReducedMotion": false,
  "autoMemoryEnabled": false,
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "editorMode": "vim",
  "fileCheckpointingEnabled": true,
  "showTurnDuration": true,
  "terminalProgressBarEnabled": true,
  "autoConnectIde": true,
  "autoInstallIdeExtension": false,
  "enabledPlugins": {
    "claude-seo@agricidaniel-claude-seo": true
  }
}
